@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/styleHeader.css">
    <link rel="stylesheet" href="/css/styleGeneral.css">
    <link rel="stylesheet" href="/css/styleDetalleProducto.css">
    <link rel="stylesheet" href="/css/minSectProdStyle.css">
    <link rel="icon" href="~/img/logo.png" type="image/x-icon">
</head>

<header id="navbar" class="prods">
    <div id="menu">
        <figure><img src="/img/logopng.png" alt="Logo"></figure>
        
        <nav class="navbar">
            <ul>
                <li class="no-estilo" style="cursor:pointer;">
                    <a asp-controller="Home" asp-action="Index" class="no-estilo" style="text-decoration:none;">
                        <i class="fas fa-home"></i> <span class="hometext">Inicio</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>
<body>
    <style>
        .image-container {
            position: relative;
            width: 100%;
            max-width: 80%;
            height: auto; /* Altura se ajusta automáticamente */
            overflow: hidden;
            border-radius: 20px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0);
        }
        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Cambié a cover para que la imagen ocupe todo el espacio sin distorsionarse */
            border-radius: 16px;
            cursor: zoom-in;
            transition: transform 0.3s ease-in-out;
        }

            .image-container img:hover {
                transform: scale(1.05); /* Agregar un pequeño efecto de zoom */
            }
    </style>
    <div class="container py-5">
       
        <div class="card border-0 detalle-producto shadow-sm">
            <div class="row no-gutters justify-content-center">
                <div class="col-md-6 image-container">
                    <img src="@Model.Producto.photoUrl" class="img-fluid rounded-left w-100 h-100 object-fit-cover" id="zoom-image" alt="@Model.Producto.nombre" style="object-fit: cover; border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem;">
                </div>
                <div class="col-md-6 bg-light">
                    <div class="card-body p-4 d-flex flex-column justify-content-between h-100">
                        <div>
                            <h2 class="text-primary font-weight-bold">@Model.Producto.nombre</h2>

                            @if (Model.Producto.precio > 0)
                            {
                                <div class="mt-2 mb-3">
                                    <span class="badge badge-success p-2 px-3" style="font-size: 1.2rem;">$@Model.Producto.precio</span>
                                </div>
                            }

                            <hr>

                            <div class="mb-3">
                                <h5 class="text-dark font-weight-semibold">Descripción del producto</h5>
                                <p class="text-muted" style="font-size: 1rem;">@Model.Producto.descripcion</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Producto.documentacion))
                            {
                                <div class="mt-3">
                                    <h6 class="mb-2">Ficha técnica:</h6>
                                    <a href="@Model.Producto.documentacion" class="btn btn-outline-info" target="_blank">
                                        <i class="fas fa-file-download mr-2"></i>Ver documento
                                    </a>
                                </div>
                            }
                        </div>

                        <div class="mt-4">
                            <a asp-controller="Producto" asp-action="Index" class="btn btn-dark btn-block">
                                <i class="fas fa-arrow-left mr-2"></i> Volver
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container product-section">
            <h3 class="section-title">Productos Relacionados</h3>

            @if (Model.ProductosRelacionados.Count != 0)
            {
                <div class="row">
                    @foreach (var prod in Model.ProductosRelacionados)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="card product-card h-100">
                                <div class="product-img-container">
                                    <img src="@prod.photoUrl" class="product-img" alt="@prod.nombre" />
                                </div>
                                <div class="product-body">
                                    <h5 class="product-title">@prod.nombre</h5>
                                    <a href="@Url.Action("Index", "DetalleProducto", new { id = @prod.id })" class="btn btn-details">Ver detalles</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <p class="text-muted">No hay productos relacionados.</p>
                </div>
            }
        </div>
    </div>
</body>
<script src="~/js/zoomScript.js"></script>
<footer class="container-fluid text-light py-5 footer" style="background-color: rgb(8, 57, 129);">
    <div class="row">
        <!-- Sobre Nosotros -->
        <div class="col-md-4 mb-4">
            <h5>Sobre Nosotros</h5>
            <p class="small">
                Somos una empresa comprometida con ofrecer los mejores servicios de envíos a nivel nacional.
                Nuestra prioridad es la satisfacción del cliente.
            </p>
        </div>

        <!-- Contacto -->
        <div class="col-md-4 mb-4">
            <h5 id="Contacto">Contacto</h5>
            <ul class="list-unstyled small">
                <li class="mt-3"><strong>Central:</strong></li>
                <li><i class="fas fa-map-marker-alt"></i> Mercedes 1541 esquina Tacuarembó</li>
                <li><i class="fas fa-phone"></i> 099510559</li>
                <li><i class="fas fa-envelope"></i> info@dentallatina.com.uy</li>
                <li class="mt-3"><strong>Sucursal:</strong></li>
                <li><i class="fas fa-map-marker-alt"></i>Las Heras 1914bis</li>
                <li><i class="fas fa-phone"></i> 24803251</li>
                <li><i class="fas fa-mobile-alt"></i> 098502999</li>
                <li class="mt-3"><strong>Sección Implantes (Central):</strong></li>
                <li><i class="fas fa-mobile-alt"></i> 098600906</li>
            </ul>
        </div>

        <!-- Redes Sociales -->
        <div class="col-md-4 mb-4 text-center">
            <h5>Síguenos</h5>
            <ul class="list-unstyled d-flex justify-content-center">
                <li class="mx-2">
                    <a href="https://www.instagram.com/dentalatina/" class="text-light" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-instagram fa-2x"></i>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Derechos reservados -->
    <div class="text-center pt-3 border-top border-secondary">
        <p class="small mb-0">&copy; 2024 Dental Latina Ltda. Todos los derechos reservados.</p>
    </div>
</footer>

</html>
