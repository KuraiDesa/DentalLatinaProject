        <section class="container-fluid p-5" style="background-color: rgba(148, 191, 255, 0.336);">
            <div class="container">
                <div class="row justify-content-center align-items-center">
                    <div class="col-12 row col-md-12 col-lg-6 justify-content-center align-items-center">
                        <h2 class="text-center p-0">¡Estate al tanto de nuestras ofertas!</h2>
                        <p class="text-center col-10">Regístrate para obtener lo último sobre próximos lanzamientos, nuevas llegadas, promociones y más.</p>
                        <form id="clienteForm">
                            <div class="row mb-3">
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label for="nombre">Nombre</label>
                                        <input type="text" class="form-control" id="nombre" name="nombre" placeholder="Ingresa tu nombre" required>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label for="apellido">Apellido</label>
                                        <input type="text" class="form-control" id="apellido" name="apellido" placeholder="Ingresa tu apellido" required>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                <label for="email2">Correo electrónico</label>
                                <input type="email" class="form-control" id="email2" name="email2" placeholder="Ingresa tu email" required>
                            </div>
                            <div class="form-group mb-3">
                                <label for="esEstudiante">¿Eres estudiante?</label>
                                <select class="form-control" id="esEstudiante" name="esEstudiante" required>
                                    <option value="true">Sí</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                            <div class="form-text text-danger" id="error-message2" style="display:none;"></div>
                            <div class="form-text text-success" id="success-message2" style="display:none; color: #28a745; font-weight: bold;">
                                Registrado correctamente
                            </div>
                            <div class="modal-footer d-flex justify-content-center">
                                <button type="submit" class="btn btn-primary">Registrarse</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
        </section>
        <script>
            document.getElementById("clienteForm").addEventListener("submit", async function (event) {
                event.preventDefault();

                const nombre = document.getElementById("nombre").value;
                const apellido = document.getElementById("apellido").value;
                const email = document.getElementById("email2").value;
                const password = document.getElementById("password").value;
                const esEstudiante = document.getElementById("esEstudiante").value === "true"; // Convierte a booleano

                const response = await fetch('/Home/ingresoCliente', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre, apellido, email, password, esEstudiante })
                });

                const result = await response.json();
                const passMessage = document.getElementById("success-message2");
                const errorMessage = document.getElementById("error-message2");
                passMessage.style.display = "none";
                errorMessage.style.display = "none";
                if (result.success) {
                    passMessage.textContent = result.pass;
                    passMessage.style.display = "block";
                } else {
                    errorMessage.textContent = result.error;
                    errorMessage.style.display = "block";
                }
            });
        </script>
