@using DTOs.DTOs
@using Dental_Latina_MVC.Controllers
@{
    Layout = null;
}
@model GeneralProductosHomeViewModel
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página Principal</title>
    <link rel="stylesheet" href="/utils/bootstrap-5.3.3/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/styleGeneral.css">
    <link rel="stylesheet" href="/css/styleHeader.css">
    <link rel="stylesheet" href="/css/styleProfesional.css">
    <link rel="stylesheet" href="/css/envios.css">
    <link rel="stylesheet" href="/css/styleSectionRegistro.css">
    <link rel="stylesheet" href="/css/styleModalAuth.css">
    <link rel="stylesheet" href="/css/styleSelectProd.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="~/img/logo.png" type="image/x-icon">

</head>

<header id="navbar">
    <div id="menu">
        <figure><img src="/img/logopng.png" alt="Logo"></figure>

        <div class="menu-icon" id="menu-icon" style="font-size:2.5vh" onclick="despliegoMenuCelular()">&#9776;</div>

        <div id="contenido" class="menu-colapsable">
            <!-- este es el contenedor que faltaba -->
            <nav class="navbar">
                <ul>
                    <li><a href="#Empresa"><i class="fas fa-building"></i> Empresa</a></li>
                    <li><a href="@Url.Action("Index", "Producto")"><i class="fas fa-box-open"></i> Productos</a></li>
                    <li><a href="#Contacto" id="liContacto"><i class="fas fa-envelope" id="cambiopaulauwu"></i> Contacto</a></li>
                    <li><a href="#Envios" class="envios-link"><i class="fas fa-shipping-fast"></i> Envios</a></li>
                    <li><a href="#Ingresar" onclick="openModal()"><i class="fas fa-sign-in-alt"></i> Ingresar</a></li>
                </ul>
            </nav>
        </div>
    </div>
</header>

<body>
    <style>
        /* Fondo oscuro */
        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.7);
        }
        /* Modal estilos */
        .modal-content {
            border-radius: 15px;
            overflow: hidden;
        }

        .modal-header {
            border-bottom: 1px solid #dee2e6;
        }
        /* Estilo de los inputs */
        .form-control {
            border-radius: 10px;
            border: 1px solid #ced4da;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 10px rgba(0, 123, 255, 0.25);
            }
        /* Estilo de los botones */
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            border-radius: 50px;
            padding: 10px 30px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #0056b3;
                box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
            }

        .btn-secondary {
            border-radius: 50px;
            padding: 10px 30px;
        }

        .container-flex {
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .product-card {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .card-img-top {
            object-fit: cover;
            height: 200px;
        }

        .card-body {
            flex: 1;
        }

        .product-card-img {
            height: 200px; /* o el alto que quieras */
            object-fit: contain; /* o "cover" si querés recorte centrado */
            object-position: center;
        }
    </style>
    <main>
        <!--CARRUSEL-->
        <section id="carruselSec">
            <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <!-- Imagen para PC -->
                        <img src="/img/banner.jpeg" class="d-none d-md-block w-100" alt="..." style="max-height:85vh;">
                        <!-- Imagen para celular -->
                        <img src="/img/bannerCelular.jpg" class="d-block d-md-none w-100" alt="...">
                    </div>
                    <div class="carousel-item">
                        <img src="/img/banner.jpeg" class="d-none d-md-block w-100" alt="..." style="max-height:85vh;">
                        <img src="/img/bannerCelular.jpg" class="d-block d-md-none w-100" alt="...">
                    </div>
                    <div class="carousel-item">
                        <img src="/img/banner.jpeg" class="d-none d-md-block w-100" alt="..." style="max-height:85vh;">
                        <img src="/img/bannerCelular.jpg" class="d-block d-md-none w-100" alt="...">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        </section>
        <!--TEXTO INSPIRACIONAL MOVIL-->
        <section>
            <div class="d-block d-md-none p-4 mx-3 mt-4 mb-4">
                <h2 class="text-center fs-4 fw-bold text-primary mb-3">
                    Transformamos sonrisas,<br>impulsamos la excelencia.
                </h2>
                <p class="text-center text-muted mb-0">
                    En <strong>Dental Latina</strong>, acompañamos a los profesionales de la odontología con productos de calidad, innovación constante y pasión por lo que hacemos.
                    Más que insumos, ofrecemos confianza, experiencia y compromiso con tu crecimiento.
                </p>
            </div>
        </section>

        <!--PRODUCTOS-->
        <section class="py-5 bg-white producto-destacado shadow mt-4 mb-4">
            <div class="container">
               <h2 class="text-center mb-5" style="color:#003fc8;">Productos destacados</h2>
                <!-- Versión para escritorio -->
      
                <div class="d-none d-md-block ">
                    
                    <div class="row justify-content-between g-4">
                        @foreach (var producto in Model.Productos)
                        {
                            <div class="col-md-2 col-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body text-center p-3">
                                        <img src="@producto.photoUrl" alt="@producto.nombre" class="img-fluid" style="max-height: 150px;">
                                        <h4 class="mt-3 mb-2">@producto.nombre</h4>
                                        @if (producto.precio != 0)
                                        {
                                            <p class="text-muted small">$@producto.precio</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted small invisible">$0</p>
                                        }
                                        <a href="@Url.Action("Index", "DetalleProducto", new { id = producto.id })" class="btn btn-details">Ver más</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Versión para móvil (carrusel) -->
                <div class="d-block d-md-none">
                    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @{
                                bool isFirst = true;
                                foreach (var producto in Model.Productos)
                                {
                                    <div class="carousel-item @(isFirst ? "active" : "")">
                                        <div class="card border-0 shadow-sm mx-2">
                                            <div class="card-body text-center p-3">
                                                <img src="@producto.photoUrl" alt="@producto.nombre" class="img-fluid" style="max-height: 150px;">
                                                <h4 class="mt-3 mb-2">@producto.nombre</h4>
                                                @if (producto.precio != 0)
                                                {
                                                    <p class="text-muted small">$@producto.precio</p>
                                                }
                                                else
                                                {
                                                    <p class="text-muted small invisible">$0</p>
                                                }
                                                <a href="@Url.Action("Index", "DetalleProducto", new { id = producto.id })" class="btn btn-sm btn-outline-primary">Ver más</a>
                                            </div>
                                        </div>
                                    </div>
                                    isFirst = false;
                                }
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" style="filter: brightness(0);" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" style="filter: brightness(0);" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>
        <script>
            // Seleccionamos la imagen
            const img = document.querySelector('.img-fluid');

            // Agregar la clase de animación solo cuando el mouse pasa sobre la imagen
            img.addEventListener('mouseenter', () => {
                img.style.animation = 'giroCompleto 1s forwards';
            });
        </script>
      
        <!--ENVIOS-->
        <section id="Envios" class="enviosBanner container-fluid d-flex justify-content-center align-items-center py-5">
            <div class="row justify-content-center align-items-center w-100">
                <div class="col-12 col-md-6 text-center">
                    <h2 class="mb-4">¡Cotiza tu envío!</h2>
                    <input id="direccionInput"
                           placeholder="Ingresa tu dirección"
                           type="text"
                           required
                           class="form-control mb-3 p-2 shadow-sm rounded"
                           oninput="validarInput()">
                    <button id="cotizarBtn"
                            class="btn btn-primary btn-lg w-100 p-1 shadow"
                            onclick="cotizar()"
                            disabled>
                        ¡Cotizar!
                    </button>
                </div>
            </div>
        </section>

        <!-- Modal -->
        <div id="modalCotizar" class="modal-overlay" style="display: none;">
            <div class="modal-content container">
                <button class="cerrar-modal" onclick="cerrarModal()">×</button>

                <div class="row">
                    <!-- Mapa -->
                    <div class="col-12 col-md-8 mb-4">
                        <div id="map" style="width: 100%; height: 100%;" class="rounded shadow-sm"></div>
                    </div>

                    <!-- Información -->
                    <div class="col-12 col-md-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="mb-3">Costo Aproximado:</h5>
                            <p id="costoEnvio" class="h4">-</p>

                            <!-- NUEVO: Monto Mínimo para Envío Gratis -->
                            <div class="my-4">
                                <h6 class="mb-2">Monto Mínimo para Envío Gratis:</h6>
                                <p id="montoMinimoEnvio" class="h6 text-success">-</p>
                            </div>

                            <!-- NUEVO: Horario de Envío -->
                            <div class="my-4">
                                <h6 class="mb-2">Horario Estimado de Entrega:</h6>
                                <p id="horarioEnvio" class="h6 text-primary">-</p>
                            </div>

                            <!-- Descarga de políticas (visible en todos los tamaños) -->
                            <div class="my-4">
                                <a href="~/documentos/propiedadDL/PoliticaEnvioMontevideo.pdf" download
                                   class="btn btn-outline-primary w-100 mb-2 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-download me-2 d-inline d-md-none"></i>
                                    <span class="d-none d-md-inline me-2">📄</span>
                                    <span class="d-none d-md-inline me-1">Descargar</span>
                                    Políticas Montevideo
                                    <i class="bi bi-download ms-2 d-none d-md-inline"></i>
                                </a>

                                <a href="~/documentos/propiedadDL/politicaEnvioInterior.pdf" download
                                   class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-download me-2 d-inline d-md-none"></i>
                                    <span class="d-none d-md-inline me-2">📄</span>
                                    <span class="d-none d-md-inline me-1">Descargar</span>
                                    Políticas Interior
                                    <i class="bi bi-download ms-2 d-none d-md-inline"></i>
                                </a>
                            </div>
                        </div>

                        <div class="mt-4">
                            <small class="text-muted d-block mb-2">⚠️ Valores aproximados. Para confirmar, consultá por WhatsApp.</small>
                            <small class="text-muted">📍 Todos los pedidos salen de Casa Central.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--REGISTRO-->
        <section class="newsletter-section mt-4 mb-4">
            <div class="newsletter-container">
                <div class="newsletter-content">
                    <div class="newsletter-text">
                        <h2 class="newsletter-title">¡No te pierdas nuestras ofertas exclusivas!</h2>
                        <div class="d-none d-md-block">
                            <p class="newsletter-subtitle">Suscríbete para recibir lo último en lanzamientos, promociones y novedades.</p>
                        </div>
                       
                        <form id="clienteForm" class="newsletter-form">
                            <div class="form-row">
                                <div class="form-group half-width">
                                    <label for="nombre" class="form-label">Nombre</label>
                                    <input type="text" class="form-input" id="nombre" name="nombre" placeholder="Ej: María" required>
                                    <div class="focus-line"></div>
                                </div>
                                <div class="form-group half-width">
                                    <label for="apellido" class="form-label">Apellido</label>
                                    <input type="text" class="form-input" id="apellido" name="apellido" placeholder="Ej: González" required>
                                    <div class="focus-line"></div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="email2" class="form-label">Correo electrónico</label>
                                <input type="email" class="form-input" id="email2" name="email2" placeholder="Ej: tuemail@dominio.com" required>
                                <div class="focus-line"></div>
                            </div>

                            <div class="form-group">
                                <label for="esEstudiante" class="form-label">¿Eres estudiante?</label>
                                <select class="form-select" id="esEstudiante" name="esEstudiante" required>
                                    <option value="" disabled selected>Selecciona una opción</option>
                                    <option value="true">Sí, soy estudiante</option>
                                    <option value="false">No soy estudiante</option>
                                </select>
                                <div class="select-arrow"></div>
                            </div>

                            <div class="form-messages">
                                <div id="error-message2" class="error-message"></div>
                                <div id="success-message2" class="success-message">¡Registro exitoso! Revisa tu correo.</div>
                            </div>

                            <button type="submit" class="submit-btn col-12">
                                <span class="btn-text">Registrarse</span>
                                <span class="btn-icon">→</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!--EMPRESA-->
        <section id="Empresa" class="mt-4 mb-4">
        
        <iframe src='https://cdn.knightlab.com/libs/timeline3/latest/embed/index.html?source=1YIy8w-Ir-XrJP-R-PRZ9PGMCK023NFaU11EkB6o2vwU&font=Default&lang=es&initial_zoom=2&height=650' width='100%' height='650' webkitallowfullscreen mozallowfullscreen allowfullscreen frameborder='0'></iframe>

        </section>

        
        <div class="modal fade" id="codigoModal" tabindex="-1" aria-labelledby="codigoModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg d-flex justify-content-center align-items-center">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="codigoModalLabel" style="color:#555dff;text-align:center;">Verificación de Correo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="instruction-text">Ingresá el código de 6 dígitos que te enviamos a tu correo electrónico.</p>

                        <!-- Inputs de código -->
                        <div class="code-inputs">
                            <input type="text" maxlength="1" class="code-input" autocomplete="off" />
                            <input type="text" maxlength="1" class="code-input" autocomplete="off" />
                            <input type="text" maxlength="1" class="code-input" autocomplete="off" />
                            <input type="text" maxlength="1" class="code-input" autocomplete="off" />
                            <input type="text" maxlength="1" class="code-input" autocomplete="off" />
                            <input type="text" maxlength="1" class="code-input" autocomplete="off" />
                        </div>
                        <div class="status-message error" id="DALEDELFI">
                            <span class="icon">!</span>
                            <span class="text">Error al ingresar el códigosssssssssssss</span>
                        </div>

                        <div class="status-message success">
                            <span class="icon">✓</span>
                            <span class="text">Código verificado correctamente</span>
                        </div>
                        <div class="status-message resend-success">
                            <span class="icon">✓</span>
                            <span class="text">¡Correo reenviado con éxito!</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-cyan" id="reenviarBtn">Reenviar correo</button>
                        <button type="button" class="btn btn-violet" id="verificarBtn" style="">Verificar</button>
                    </div>
                </div>
            </div>
        </div>
       
        

       <script src="~/js/controlDeMail.js"></script>

        <div id="whatsapp" style="position: fixed; bottom: 40px; right:40px">
            <a href="https://wa.me/59899510559"><svg style="min-width: 50px; min-height: 50px;" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 256 258"><defs><linearGradient id="logosWhatsappIcon0" x1="50%" x2="50%" y1="100%" y2="0%"><stop offset="0%" stop-color="#1faf38" /><stop offset="100%" stop-color="#60d669" /></linearGradient><linearGradient id="logosWhatsappIcon1" x1="50%" x2="50%" y1="100%" y2="0%"><stop offset="0%" stop-color="#f9f9f9" /><stop offset="100%" stop-color="#fff" /></linearGradient></defs><path fill="url(#logosWhatsappIcon0)" d="M5.463 127.456c-.006 21.677 5.658 42.843 16.428 61.499L4.433 252.697l65.232-17.104a123 123 0 0 0 58.8 14.97h.054c67.815 0 123.018-55.183 123.047-123.01c.013-32.867-12.775-63.773-36.009-87.025c-23.23-23.25-54.125-36.061-87.043-36.076c-67.823 0-123.022 55.18-123.05 123.004" /><path fill="url(#logosWhatsappIcon1)" d="M1.07 127.416c-.007 22.457 5.86 44.38 17.014 63.704L0 257.147l67.571-17.717c18.618 10.151 39.58 15.503 60.91 15.511h.055c70.248 0 127.434-57.168 127.464-127.423c.012-34.048-13.236-66.065-37.3-90.15C194.633 13.286 162.633.014 128.536 0C58.276 0 1.099 57.16 1.071 127.416m40.24 60.376l-2.523-4.005c-10.606-16.864-16.204-36.352-16.196-56.363C22.614 69.029 70.138 21.52 128.576 21.52c28.3.012 54.896 11.044 74.9 31.06c20.003 20.018 31.01 46.628 31.003 74.93c-.026 58.395-47.551 105.91-105.943 105.91h-.042c-19.013-.01-37.66-5.116-53.922-14.765l-3.87-2.295l-40.098 10.513z" /><path fill="#fff" d="M96.678 74.148c-2.386-5.303-4.897-5.41-7.166-5.503c-1.858-.08-3.982-.074-6.104-.074c-2.124 0-5.575.799-8.492 3.984c-2.92 3.188-11.148 10.892-11.148 26.561s11.413 30.813 13.004 32.94c1.593 2.123 22.033 35.307 54.405 48.073c26.904 10.609 32.379 8.499 38.218 7.967c5.84-.53 18.844-7.702 21.497-15.139c2.655-7.436 2.655-13.81 1.859-15.142c-.796-1.327-2.92-2.124-6.105-3.716s-18.844-9.298-21.763-10.361c-2.92-1.062-5.043-1.592-7.167 1.597c-2.124 3.184-8.223 10.356-10.082 12.48c-1.857 2.129-3.716 2.394-6.9.801c-3.187-1.598-13.444-4.957-25.613-15.806c-9.468-8.442-15.86-18.867-17.718-22.056c-1.858-3.184-.199-4.91 1.398-6.497c1.431-1.427 3.186-3.719 4.78-5.578c1.588-1.86 2.118-3.187 3.18-5.311c1.063-2.126.531-3.986-.264-5.579c-.798-1.593-6.987-17.343-9.819-23.64" /></svg></a>
        </div>
        <br>
        <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="loginModalLabel">Ingreso</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <form id="loginForm">
                            <div class="form-group mb-3">
                                <label for="email">Correo electrónico</label>
                                <input type="email" class="form-control" id="email" name="email" placeholder="Ingresa tu email" required>
                            </div>
                            <div class="form-group mb-3">
                                <label for="password">Contraseña</label>
                                <input type="password" class="form-control" id="password" name="password" placeholder="Ingresa tu contraseña" required>
                            </div>
                            <div class="form-text text-danger" id="error-message" style="display:none;"></div>
                            <div class="modal-footer d-flex justify-content-center">
                                <button type="submit" class="btn btn-primary">Ingresar</button>
                            </div>
                        </form>
                        <script>
                            document.getElementById("loginForm").addEventListener("submit", async function (event) {
                                event.preventDefault();

                                const email = document.getElementById("email").value;
                                const password = document.getElementById("password").value;
                                console.log({ email, password });
                                const response = await fetch('/Home/Login', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ email, password })
                                });

                                const result = await response.json();

                                const errorMessage = document.getElementById("error-message");

                                if (result.success) {
                                    window.location.href = result.redirectUrl;
                                } else {
                                    errorMessage.textContent = result.error2;
                                    errorMessage.style.display = "block";
                                }
                            });
                        </script>
                    </div>
                </div>
            </div>
        </div>

        </div>
    </main>
    <footer class="container-fluid text-light py-5">
        <div class="row">
            <!-- Sobre Nosotros -->
            <div class="col-md-4 mb-4">
                <h5>Sobre Nosotros</h5>
