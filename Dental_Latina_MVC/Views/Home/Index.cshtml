    <style>
        /* Fondo oscuro */
        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.7);
        }
        /* Modal estilos */
        .modal-content {
            border-radius: 15px;
            overflow: hidden;
        }

        .modal-header {
            border-bottom: 1px solid #dee2e6;
        }
        /* Estilo de los inputs */
        .form-control {
            border-radius: 10px;
            border: 1px solid #ced4da;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 10px rgba(0, 123, 255, 0.25);
            }
        /* Estilo de los botones */
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            border-radius: 50px;
            padding: 10px 30px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #0056b3;
                box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
            }

        .btn-secondary {
            border-radius: 50px;
            padding: 10px 30px;
        }
    </style>
