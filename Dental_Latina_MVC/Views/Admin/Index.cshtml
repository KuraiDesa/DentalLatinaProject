        <script>
            // Suponiendo que tienes los datos de las zonas en el modelo
            const zonas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.zonas));

            function cargarDatosZona() {
                const select = document.getElementById("zonaSeleccionada");
                const zonaId = select.value;

                const inputNombre = document.getElementById("zonaNombre"); 
                const inputCosto = document.getElementById("costoEnvio"); 
                const inputHorario = document.getElementById("horarioEnvio");
                const inputMinimo = document.getElementById("minimoEnvio");
                if (!zonaId) {
                    // Desactivar y limpiar si no hay selección
                    inputNombre.value = '';
                    inputCosto.value = '';
                    inputHorario.value = '';
                    inputMinimo.value = '';
                    inputNombre.disabled = true;
                    inputCosto.disabled = true;
                    inputHorario.disabled = true;
                    inputMinimo.disabled = true;
                    return;
                }

                // Buscar zona por ID
                const zona = zonas.find(z => z.id == zonaId);
                if (zona) {
                    inputNombre.value = zona.nombre;
                    inputCosto.value = zona.precio;
                    inputHorario.value = zona.horario;
                    inputMinimo.value = zona.minimoDeEnvio;
                    inputNombre.disabled = false;
                    inputCosto.disabled = false;
                    inputHorario.disabled = false;
                    inputMinimo.disabled = false;
                }
            }

            // Inicialmente desactivar inputs
            window.addEventListener("DOMContentLoaded", () => {
                document.getElementById("zonaNombre").disabled = true;
                document.getElementById("costoEnvio").disabled = true;
                document.getElementById("horarioEnvio").disabled = true;
                document.getElementById("minimoEnvio").disabled = true;
            });
        </script>
