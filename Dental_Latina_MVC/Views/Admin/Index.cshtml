    <script>
        async function agregarNuevaCategoria() {
            const nuevaCategoria = document.getElementById("nuevaCategoriaInput").value.trim();
            if (!nuevaCategoria) return alert("El nombre no puede estar vacío");

            try {
                const response = await fetch('/TuControlador/AgregarCategoria', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value // si usás AntiForgery
                    },
                    body: JSON.stringify({ nombre: nuevaCategoria })
                });

                if (response.ok) {
                    const nueva = await response.json(); // Suponiendo que devuelve { id, nombre }

                    const select = document.getElementById("categoriaProducto");
                    const option = document.createElement("option");
                    option.value = nueva.id;
                    option.text = nueva.nombre;
                    option.selected = true;
                    select.appendChild(option);

                    // Limpiar e invisibilizar
                    document.getElementById("nuevaCategoriaInput").value = "";
                    document.getElementById("agregarcategoria").style.display = "none";
                    document.getElementById("c_add_cat_btn").style.display = "none";
                } else {
                    const error = await response.text();
                    alert("Error al agregar categoría: " + error);
                }
            } catch (err) {
                alert("Ocurrió un error al conectar con el servidor.");
                console.error(err);
            }
        }
    </script>
    <!--SCRIPT MANDAR MAILS-->
    <script>
        document.getElementById('formEnvioCorreo').addEventListener('submit', function (e) {
            e.preventDefault();
            let isValid = true;

            // Validar campo asunto
            const asunto = document.getElementById('asunto');
            if (!asunto.value.trim()) {
                isValid = false;
                alert('Por favor ingrese un asunto');
                asunto.focus();
                return;
            }

            // Validar campo mensaje (usando TinyMCE)
            const mensajeContent = tinymce.get('mensaje').getContent({ format: 'text' });
            if (!mensajeContent.trim()) {
                isValid = false;
                alert('Por favor ingrese un mensaje');
                tinymce.get('mensaje').focus();
                return;
            }

            if (isValid) {
                // Obtener el HTML del editor TinyMCE
                let mensajeHTML = tinymce.get('mensaje').getContent();

                // Reemplazar imágenes con URLs absolutas si es necesario
                mensajeHTML = mensajeHTML.replace(/src="([^"]*)"/g, function (match, p1) {
                    if (!p1.startsWith('http') && !p1.startsWith('cid:')) {
                        // Si es una ruta relativa, convertir a absoluta o manejarla como adjunto
                        return `src="https://tusitio.com${p1.startsWith('/') ? p1 : '/' + p1}"`;
                    }
                    return match;
                });

                // Crear FormData y agregar el contenido del editor
                const formData = new FormData(this);
                formData.set('mensaje', mensajeHTML); // Reemplazar el valor del textarea

                fetch('/Admin/enviarCorreos', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Correo enviado con éxito');
                            this.reset();
                            tinymce.get('mensaje').setContent(''); // Limpiar el editor
                        } else {
                            alert('Error: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Error al enviar el formulario');
                    });
            }
        });
        </script>
